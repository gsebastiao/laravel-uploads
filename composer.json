{
    "name": "gsebastiao/laravel-uploads",
    "description": "Pacote Laravel para upload de arquivos (multipart e base64) com geração de thumbnails, metadados persistidos e organização por contexto.",
    "type": "library",
    "keywords": ["laravel", "upload", "files", "base64", "thumbnail", "storage"],
    "license": "MIT",
    "authors": [
        {
            "name": "G. Sebastiao",
            "email": "dev@gsebastiao.example"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Gsebastiao\\LaravelUploads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gsebastiao\\LaravelUploads\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gsebastiao\\LaravelUploads\\UploadServiceProvider"
            ],
            "aliases": {
                "Upload": "Gsebastiao\\LaravelUploads\\Facades\\Upload"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
